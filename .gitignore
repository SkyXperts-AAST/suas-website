# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent / planning tooling
/.claude/
/.planning/

# source CAD models — not served at runtime (only public/models/ is loaded);
# kept out of git history to avoid bloat. models/subsystem-map.json is tracked.
/models/*.glb

# full-resolution HDRI sources, kept as backups of the downsampled 512px maps
# actually shipped from public/hdri/. ~3.2MB, never served — same bloat
# reasoning as the CAD models above.
/models/hdri-source/
